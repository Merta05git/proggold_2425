const express = require('express');
const app = express();
const port = 3000;

app.use(express.json());

// Mock data
let events = [
    { id: 1, name: 'Event 1', details: 'Details of Event 1' },
    { id: 2, name: 'Event 2', details: 'Details of Event 2' }
];

let comments = [
    { id: 1, text: 'Comment about Event 1', relatedEventId: 1 },
    { id: 2, text: 'Comment about Event 2', relatedEventId: 2 }
];

// GET method to list events
app.get('/events', (req, res) => {
    res.json(events.map(event => ({ id: event.id, name: event.name })));
});

// GET event details
app.get('/events/:id', (req, res) => {
    const event = events.find(e => e.id == req.params.id);
    if (event) {
        res.json({
            ...event,
            comments: comments.filter(c => c.relatedEventId == event.id)
        });
    } else {
        res.status(404).send('Event not found');
    }
});

// POST method to add an event
app.post('/events', (req, res) => {
    const newEvent = {
        id: events.length + 1,
        name: req.body.name,
        details: req.body.details
    };
    events.push(newEvent);
    res.status(201).json(newEvent);
});

app.listen(port, () => {
    console.log(`Server running at http://localhost:${port}`);
});
